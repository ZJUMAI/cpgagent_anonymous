medclaw/knowledge/guidelines/**/*.faiss

# Local latent guideline planner training outputs
guideline_planner/cache/
guideline_planner/checkpoints/
guideline_planner/outputs/
guideline_planner/runs/

# Runtime outputs
artifacts/
runs/
runs_casestudy/

# Local data processing workspace
data/

# Versioned Planner V2 pilot dataset (including its tiny mock grounding slots).
!datasets/planner_v2_pilot/memory_catalog_mock/**/*.pt

# Local benchmark case data. Keep source reports and evaluation metadata visible to Git.
examples/cases/**
!examples/cases/**/
!examples/cases/**/evaluation/
!examples/cases/**/evaluation/**/
!examples/cases/**/evaluation/**/*.json
!examples/cases/**/evaluation/**/*.md
!examples/cases/**/evaluation/**/*.txt
!examples/cases/**/evaluation/**/*.tsv
!examples/cases/**/evaluation/**/*.csv
!examples/cases/**/reports/
!examples/cases/**/reports/**/
!examples/cases/**/reports/**/*.md
!examples/cases/**/reports/**/*.txt
!examples/cases/**/reports/**/*.json

# Keep large local case modalities ignored.
examples/cases/**/radiology/nifti/**
examples/cases/**/radiology/masks/**
examples/cases/**/pathology/wsi/**
examples/cases/**/pathology/roi_*/**
examples/cases/**/pathology/conch_roi/**
