# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
htmlcov/

# Local caches and environments
.cache/
.venv/
.conda/

# Secrets and local configuration
.env
.env.*
!.env.example

# IDE and OS metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Downloaded model weights and inference binaries
*.pt
*.pth
*.ckpt
*.bin
*.onnx
*.safetensors
*.tflite

# Skill-local runtime scratch directories
medclaw/skills/**/cache/
medclaw/skills/**/model_cache/
medclaw/skills/**/weights/
medclaw/skills/**/checkpoints/
medclaw/skills/**/outputs/
medclaw/skills/**/logs/

# Local guideline embedding/vector indexes
