# Example values only. This file is not loaded automatically.
# Bash: set -a; source .env; set +a
# PowerShell: assign the corresponding $env:NAME values explicitly.

MEDCLAW_LOCAL_BASE_URL=http://127.0.0.1:8087/v1
MEDCLAW_LOCAL_API_KEY=local-development-key
MEDCLAW_LOCAL_MODEL=local-model-name

# Optional cloud providers
# DASHSCOPE_API_KEY=
# OPENAI_API_KEY=

# Public Lung cases in the anonymous artifact
# LUNG_CASES_ROOT=data/LUNG
# MEDCLAW_CASES_ROOT=data/LUNG

# Planner inference requires a separately obtained trained release.
# PLANNER_RELEASE_DIR=/path/to/planner/release
